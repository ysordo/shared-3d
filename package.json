{
  "name": "shared-3d",
  "version": "1.0.5",
  "description": "The most advanced, beautiful and extensible React + Three.js 3D library. Zero-config, plugin-based, with intelligent caching, cinematic transitions and full TypeScript support.",
  "keywords": [
    "react",
    "three.js",
    "3d",
    "webgl",
    "r3f",
    "scene",
    "orchestrator",
    "gltf",
    "draco",
    "hdri",
    "post-processing",
    "wireframe",
    "animation",
    "material",
    "typescript",
    "hooks",
    "components",
    "ui",
    "3d-ui",
    "cinematic"
  ],
  "author": "Junior Yohan Sordo García <juniorsordogarcia@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysordo/shared-3d"
  },
  "homepage": "https://github.com/ysordo/shared-3d#readme",
  "bugs": "https://github.com/ysordo/shared-3d/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/core/cache/server/index.server.d.ts",
      "import": "./dist/core/cache/server/index.server.js",
      "require": "./dist/core/cache/server/index.server.cjs"
    },
    "./three": {
      "types": "./dist/lib/three.d.ts",
      "import": "./dist/lib/three.js",
      "require": "./dist/lib/three.cjs"
    },
    "./react/*": "./dist/react/*",
    "./hooks/*": "./dist/hooks/*",
    "./core/*": "./dist/core/*",
    "./context/*": "./dist/context/*",
    "./lib/*": "./dist/lib/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "docs": "typedoc",
    "test": "echo \"No tests yet - add vitest soon!\""
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/three": "^0.177.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.12.4"
}